# ==============================================================================
# C32-W8: Aggressive MoE-Pruning Batch Tau (0.45 @ B=32, 0.42 @ B=24, 0.0 @ B=12)
#       + Un-Starved S8-P6v2 Fast Beam-2 Tree with BF16 C=1 Drafter AR!
# ==============================================================================
# C=32: Keep K(1,2,3) + aggressive tau for B=13..32 (prunes hopeless Prose/Code tokens from MoE!)
#       and tau=0.0 for B=9..12 (K=1 Prose tail where tau=0 won 416.3 vs 410.2 tok/s!)
SPEC_BATCH_SCHEDULE='[[1,1,7],[2,4,7],[5,8,5],[9,12,1],[13,24,2],[25,32,3]]'
INKLING_DINK_BATCH_TAU='1:-1,4:0.25,8:0.32,12:0.0,24:0.42,32:0.45'

# C=1: Restore BF16 drafter AR (h64_q4 cost -4..6.6% pos0 on C=1!) + restore s7-dbtau cal
#      + un-starve S8-P6v2 Fast Beam-2 Tree siblings while keeping its -2.0 ms/step speedup!
INKLING_DRAFT_AR_MODE=bf16
INKLING_L2PF_MAX_DRAFT_US=28
INKLING_L2PF_DRAFT_MB=6.5
INKLING_L2PF_DRAFT_ATTN=0
INKLING_CONF_CAL=/root/.cache/inkling-cal-s7-dbtau.json
INKLING_TREE_SPEC=1
INKLING_TREE_WS_MAX=2
INKLING_TREE_SIB_DISC=0.20
INKLING_TREE_SIB_PENALTY_MS=0.0
INKLING_TREE_SIB_SCALE=0.95
INKLING_TREE_P2_MIN=0.08

# ==============================================================================
# C32-W9: 372.3M-elem 0-ULP Fused SConv+AR C32 + Optimal tau(0.30/0.32/0.0)
#       + S8-P6v2 Fast Beam-2 Tree ACTUALLY ENABLED (INKLING_MARKOV_FUSE_REDUCE=1!)
# ==============================================================================
# C=32: Optimal tau sweet spot + 0-ULP libfused_sconv_ar_c32_exact.so (-0.84..-1.49 ms/step!)
SPEC_BATCH_SCHEDULE='[[1,1,7],[2,4,7],[5,8,5],[9,12,1],[13,24,2],[25,32,3]]'
INKLING_DINK_BATCH_TAU='1:-1,4:0.25,8:0.32,12:0.0,24:0.32,32:0.30'
INKLING_FUSED_SCONV_AR_C32=1
INKLING_FUSED_SCONV_AR_C32_LIB=/rdma/libfused_sconv_ar_c32_exact.so

# C=1: UNLOCK S8-P6v2 Fast Beam-2 Tree (speculator.py:3008 requires INKLING_MARKOV_FUSE_REDUCE=1!)
INKLING_MARKOV_FUSE_REDUCE=1
INKLING_TREE_SPEC=1
INKLING_TREE_WS_MAX=2
INKLING_TREE_SIB_DISC=0.0
INKLING_TREE_SIB_PENALTY_MS=0.10
INKLING_TREE_SIB_SCALE=0.85
INKLING_TREE_P2_MIN=0.10
# === C32-W10 Tier-2 Stage A: compaction ON ===
INKLING_LIVE_COMPACT=1
INKLING_LIVE_COMPACT_MIN_B=2
INKLING_LIVE_COMPACT_MIN_M=17
INKLING_LIVE_COMPACT_MAX_M=256
INKLING_LIVE_COMPACT_MAX_REQS=32
INKLING_LIVE_COMPACT_HEAD=1
INKLING_LIVE_COMPACT_RDMA=1
INKLING_BF11_NLIVE=1
INKLING_ATTN_NLIVE=1
INKLING_SCONV_NLIVE=1
INKLING_ATTN_RES_NLIVE=1
INKLING_TREE_SPEC=0

# === EXP-6: Unified Wave-V3 Qualified Checkpoint ===
# 1. C=32 + C=1 Bit-Exact Decode (0-ULP):
RDMA_AR_LEVEL_DB=1
RDMA_AR_ROWS_P2=1
RDMA_AR_WIRE_BF12=0
RDMA_AR_ROWS_BF12_OS4=0
INKLING_C32_MOE_MIN_M=17
INKLING_C32_ROUTER_MODE=bf12
INKLING_C32_ROUTER_BF12_CAPTURE_ONLY=1
INKLING_BF11_LIB=/rdma/libbf11_flip_exact_c32.so
INKLING_BF11_C32_MAX_M=64

# 2. 1M Prefill Compute: v4 Persistent NVFP4 W2 (P=2, 1.22-1.26x faster) + keep v3 W13
INKLING_PF_MOE_NATIVE_LIB=/rdma/libpf_moe_native_sm121_v4.so
INKLING_PF_MOE_PERSISTENT=1
INKLING_PF_MOE_PERSISTENT_W13=0
INKLING_PF_MOE_LPT_PLAN=1
INKLING_PF_MOE_SPLIT_M=1024
INKLING_PF_MOE_W2_PANELS=2
INKLING_PF_MOE_L2_ZERO_SLICE=1
INKLING_PF_MOE_ASYNC_ZERO=0

# 3. 1M Prefill Collectives + DBO: Zero-Incast 3-Step RHD INT8 RS (1.09x vs BF16 Ring) + DBO Interleave + Depth-2 Limbo Cap
INKLING_PF_RHD_COMM_LIB=/rdma/libpf_rhd_comm_sm121.so
INKLING_PREFILL_SP_RS_MODE=rhd_int8
INKLING_PREFILL_SP_RS_MIN_T=2048
INKLING_PREFILL_SP_RHD_TRANSPORT=pynccl_p2p
INKLING_PREFILL_SP_RHD_PIPE=0
INKLING_PREFILL_SP_AG_MODE=nccl
INKLING_PREFILL_DBO_INTERLEAVE=1
INKLING_PREFILL_DBO_MAX_INFLIGHT_LAYERS=2
INKLING_PREFILL_SP_PAD_TAIL=1
INKLING_PREFILL_SP_PAD_MIN_T=2048
INKLING_PREFILL_SP_ZERO_SYNC=1
INKLING_PF_GLOBAL_ZERO_SYNC=1

# 4. Multi-1M KV Residency: Compact Logical-Block FP8 Shadow K (1.016 GiB vs 7.24 GiB -> +6.23 GiB freed!)
INKLING_PF_GLOBAL_LIB=/rdma/libglobal_attn_sage2_sm121_v5.so
INKLING_PF_SHADOW_K_COMPACT=1
INKLING_PF_SHADOW_K_CAP_BLKS=4096

# === EXP-6B: Isolate v4 W2 persistent + Compact Shadow K on clean NCCL BF16 Ring (no RHD / no DBO interleave / PF_GLOBAL_ZERO_SYNC=0) ===
INKLING_PREFILL_SP_RS_MODE=nccl
INKLING_PREFILL_DBO_INTERLEAVE=0
INKLING_PREFILL_DBO_MAX_INFLIGHT_LAYERS=0
INKLING_PREFILL_SP_ZERO_SYNC=0
INKLING_PF_GLOBAL_ZERO_SYNC=0
INKLING_PREFILL_SP_PAD_TAIL=0
